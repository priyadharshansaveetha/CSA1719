        "\n",
        "# Vacuum Cleaner Problem using Simple Reflex Agent\n",
        "\n",
        "def vacuum_cleaner(location, room_A, room_B):\n",
        "\n",
        "    print(\"Initial State:\")\n",
        "    print(\"Room A:\", room_A)\n",
        "    print(\"Room B:\", room_B)\n",
        "    print(\"Vacuum Location:\", location)\n",
        "\n",
        "    while room_A == \"Dirty\" or room_B == \"Dirty\":\n",
        "\n",
        "        if location == \"A\":\n",
        "            if room_A == \"Dirty\":\n",
        "                print(\"\\nVacuum is cleaning Room A\")\n",
        "                room_A = \"Clean\"\n",
        "            else:\n",
        "                print(\"\\nMoving from Room A to Room B\")\n",
        "                location = \"B\"\n",
        "\n",
        "        elif location == \"B\":\n",
        "            if room_B == \"Dirty\":\n",
        "                print(\"\\nVacuum is cleaning Room B\")\n",
        "                room_B = \"Clean\"\n",
        "            else:\n",
        "                print(\"\\nMoving from Room B to Room A\")\n",
        "                location = \"A\"\n",
        "\n",
        "    print(\"\\nFinal State:\")\n",
        "    print(\"Room A:\", room_A)\n",
        "    print(\"Room B:\", room_B)\n",
        "    print(\"Both rooms are clean!\")\n",
        "\n",
        "\n",
        "# Main Program\n",
        "room_A = \"Dirty\"\n",
        "room_B = \"Dirty\"\n",
        "location = \"A\"\n",
        "\n",
        "vacuum_cleaner(location, room_A, room_B)\n"
      ]
