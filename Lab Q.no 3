        "\n",
        "# Water Jug Problem using BFS\n",
        "\n",
        "from collections import deque\n",
        "\n",
        "def water_jug(capacity1, capacity2, target):\n",
        "\n",
        "    visited = set()\n",
        "    queue = deque([(0, 0)])\n",
        "\n",
        "    while queue:\n",
        "        jug1, jug2 = queue.popleft()\n",
        "\n",
        "        if (jug1, jug2) in visited:\n",
        "            continue\n",
        "\n",
        "        visited.add((jug1, jug2))\n",
        "\n",
        "        print(\"Jug 1:\", jug1, \"Jug 2:\", jug2)\n",
        "\n",
        "        # Check whether target is reached\n",
        "        if jug1 == target or jug2 == target:\n",
        "            print(\"Target reached!\")\n",
        "            return True\n",
        "\n",
        "        # Possible operations\n",
        "        next_states = [\n",
        "            (capacity1, jug2),  # Fill Jug 1\n",
        "            (jug1, capacity2),  # Fill Jug 2\n",
        "            (0, jug2),          # Empty Jug 1\n",
        "            (jug1, 0),          # Empty Jug 2\n",
        "            (max(0, jug1 - (capacity2 - jug2)),\n",
        "             min(capacity2, jug1 + jug2)),  # Pour Jug 1 into Jug 2\n",
        "            (min(capacity1, jug1 + jug2),\n",
        "             max(0, jug2 - (capacity1 - jug1)))  # Pour Jug 2 into Jug 1\n",
        "        ]\n",
        "\n",
        "        for state in next_states:\n",
        "            if state not in visited:\n",
        "                queue.append(state)\n",
        "\n",
        "    print(\"Target cannot be reached!\")\n",
        "    return False\n",
        "\n",
        "\n",
        "# Main Program\n",
        "jug1_capacity = 4\n",
        "jug2_capacity = 3\n",
        "target = 2\n",
        "\n",
        "water_jug(jug1_capacity, jug2_capacity, target)\n"
      ]
