        "%%writefile sum.pl\n",
        "sum(0, 0).\n",
        "\n",
        "sum(N, S) :-\n",
        "    N > 0,\n",
        "    N1 is N - 1,\n",
        "    sum(N1, S1),\n",
        "    S is N + S1.\n",
        "\n",
        "% To run this in Google Colab:\n",
        "% 1. In a new cell, install the Prolog interpreter:\n",
        "%    !apt-get install -y swi-prolog\n",
        "%\n",
        "% 2. Query your code from the command line:\n",
        "%    !swipl -s sum.pl -g \"sum(5, S), writeln(S), halt.\""
      ]
