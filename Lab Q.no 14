      "source": [
        "\n",
        "# Alpha-Beta Pruning Algorithm\n",
        "\n",
        "def minimax(depth, node, is_max, scores, alpha, beta):\n",
        "    # Base condition\n",
        "    if depth == 3:\n",
        "        return scores[node]\n",
        "\n",
        "    if is_max:\n",
        "        best = float('-inf')\n",
        "\n",
        "        for i in range(2):\n",
        "            val = minimax(depth + 1, node * 2 + i,\n",
        "                          False, scores, alpha, beta)\n",
        "            best = max(best, val)\n",
        "            alpha = max(alpha, best)\n",
        "\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "\n",
        "        return best\n",
        "\n",
        "    else:\n",
        "        best = float('inf')\n",
        "\n",
        "        for i in range(2):\n",
        "            val = minimax(depth + 1, node * 2 + i,\n",
        "                          True, scores, alpha, beta)\n",
        "            best = min(best, val)\n",
        "            beta = min(beta, best)\n",
        "\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "\n",
        "        return best\n",
        "\n",
        "\n",
        "# Main Program\n",
        "scores = [3, 5, 6, 9, 1, 2, 0, -1]\n",
        "\n",
        "print(\"Alpha-Beta Pruning Algorithm\")\n",
        "\n",
        "result = minimax(0, 0, True, scores,\n",
        "                 float('-inf'), float('inf'))\n",
        "\n",
        "print(\"Optimal Value:\", result)\n"
      ]
