        "\n",
        "# Missionaries and Cannibals Problem using BFS\n",
        "\n",
        "from collections import deque\n",
        "\n",
        "def is_valid(m, c):\n",
        "    if m < 0 or c < 0 or m > 3 or c > 3:\n",
        "        return False\n",
        "\n",
        "    # Check left bank\n",
        "    if m > 0 and m < c:\n",
        "        return False\n",
        "\n",
        "    # Check right bank\n",
        "    if (3 - m) > 0 and (3 - m) < (3 - c):\n",
        "        return False\n",
        "\n",
        "    return True\n",
        "\n",
        "\n",
        "def solve():\n",
        "    start = (3, 3, 0)\n",
        "    goal = (0, 0, 1)\n",
        "\n",
        "    queue = deque([(start, [start])])\n",
        "    visited = set()\n",
        "\n",
        "    moves = [\n",
        "        (1, 0),  # 1 Missionary\n",
        "        (2, 0),  # 2 Missionaries\n",
        "        (0, 1),  # 1 Cannibal\n",
        "        (0, 2),  # 2 Cannibals\n",
        "        (1, 1)   # 1 Missionary and 1 Cannibal\n",
        "    ]\n",
        "\n",
        "    while queue:\n",
        "        state, path = queue.popleft()\n",
        "\n",
        "        if state == goal:\n",
        "            print(\"Solution Found!\\n\")\n",
        "\n",
        "            for step, s in enumerate(path):\n",
        "                m, c, boat = s\n",
        "                side = \"Left\" if boat == 0 else \"Right\"\n",
        "\n",
        "                print(\"Step\", step)\n",
        "                print(\"Missionaries on Left:\", m)\n",
        "                print(\"Cannibals on Left:\", c)\n",
        "                print(\"Boat Position:\", side)\n",
        "                print(\"-------------------\")\n",
        "\n",
        "            return\n",
        "\n",
        "        if state in visited:\n",
        "            continue\n",
        "\n",
        "        visited.add(state)\n",
        "\n",
        "        m, c, boat = state\n",
        "\n",
        "        for dm, dc in moves:\n",
        "            if boat == 0:\n",
        "                new_state = (m - dm, c - dc, 1)\n",
        "            else:\n",
        "                new_state = (m + dm, c + dc, 0)\n",
        "\n",
        "            if is_valid(new_state[0], new_state[1]):\n",
        "                if new_state not in visited:\n",
        "                    queue.append((new_state, path + [new_state]))\n",
        "\n",
        "    print(\"No solution exists!\")\n",
        "\n",
        "\n",
        "# Main Program\n",
        "solve()\n"
      ]
    }
