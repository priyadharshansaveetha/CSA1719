        "\n",
        "# Crypt-Arithmetic Problem using Backtracking\n",
        "\n",
        "from itertools import permutations\n",
        "\n",
        "def solve_cryptarithmetic():\n",
        "    letters = 'SENDMORY'\n",
        "\n",
        "    for perm in permutations(range(10), len(letters)):\n",
        "        values = dict(zip(letters, perm))\n",
        "\n",
        "        # First letters cannot be zero\n",
        "        if values['S'] == 0 or values['M'] == 0:\n",
        "            continue\n",
        "\n",
        "        SEND = (values['S'] * 1000 +\n",
        "                values['E'] * 100 +\n",
        "                values['N'] * 10 +\n",
        "                values['D'])\n",
        "\n",
        "        MORE = (values['M'] * 1000 +\n",
        "                values['O'] * 100 +\n",
        "                values['R'] * 10 +\n",
        "                values['E'])\n",
        "\n",
        "        MONEY = (values['M'] * 10000 +\n",
        "                 values['O'] * 1000 +\n",
        "                 values['N'] * 100 +\n",
        "                 values['E'] * 10 +\n",
        "                 values['Y'])\n",
        "\n",
        "        if SEND + MORE == MONEY:\n",
        "            print(\"Solution Found:\")\n",
        "            for letter in letters:\n",
        "                print(letter, \"=\", values[letter])\n",
        "\n",
        "            print(\"\\nSEND =\", SEND)\n",
        "            print(\"MORE =\", MORE)\n",
        "            print(\"MONEY =\", MONEY)\n",
        "            print(\"Result:\", SEND, \"+\", MORE, \"=\", MONEY)\n",
        "            return\n",
        "\n",
        "    print(\"No solution exists!\")\n",
        "\n",
        "\n",
        "# Main Program\n",
        "solve_cryptarithmetic()\n"
      ]
