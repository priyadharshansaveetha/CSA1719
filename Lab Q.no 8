        "\n",
        "# DFS (Depth First Search) Implementation\n",
        "\n",
        "def DFS(graph, start, visited=None):\n",
        "    if visited is None:\n",
        "        visited = set()\n",
        "\n",
        "    if start not in visited:\n",
        "        print(start, end=\" \")\n",
        "        visited.add(start)\n",
        "\n",
        "        for neighbour in graph[start]:\n",
        "            DFS(graph, neighbour, visited)\n",
        "\n",
        "\n",
        "# Main Program\n",
        "graph = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['A', 'D', 'E'],\n",
        "    'C': ['A', 'F'],\n",
        "    'D': ['B'],\n",
        "    'E': ['B', 'F'],\n",
        "    'F': ['C', 'E']\n",
        "}\n",
        "\n",
        "print(\"DFS Traversal:\")\n",
        "DFS(graph, 'A')\n"
      ]
    }
