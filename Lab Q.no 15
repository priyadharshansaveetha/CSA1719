        "# Decision Tree Implementation\n",
        "\n",
        "import pandas as pd\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn import tree\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Create Dataset\n",
        "data = {\n",
        "    'Weather': ['Sunny', 'Sunny', 'Rainy', 'Sunny',\n",
        "                'Rainy', 'Rainy', 'Sunny', 'Rainy'],\n",
        "    'Temperature': ['Hot', 'Cold', 'Hot', 'Mild',\n",
        "                    'Cold', 'Mild', 'Hot', 'Cold'],\n",
        "    'Play': ['No', 'No', 'Yes', 'Yes',\n",
        "             'Yes', 'Yes', 'No', 'Yes']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Input and Output\n",
        "X = df[['Weather', 'Temperature']]\n",
        "y = df['Play']\n",
        "\n",
        "# Convert categorical data into numerical data\n",
        "X = pd.get_dummies(X)\n",
        "\n",
        "# Create Decision Tree Classifier\n",
        "model = DecisionTreeClassifier(criterion='entropy')\n",
        "\n",
        "# Train the model\n",
        "model.fit(X, y)\n",
        "\n",
        "# Predict the result\n",
        "sample = pd.DataFrame(\n",
        "    [{'Weather_Sunny': 1, 'Weather_Rainy': 0,\n",
        "      'Temperature_Hot': 1, 'Temperature_Cold': 0,\n",
        "      'Temperature_Mild': 0}]\n",
        ")\n",
        "\n",
        "# Reorder sample columns to match the training feature order\n",
        "sample = sample[X.columns]\n",
        "\n",
        "prediction = model.predict(sample)\n",
        "\n",
        "print(\"Decision Tree Prediction:\")\n",
        "print(\"Weather = Sunny, Temperature = Hot\")\n",
        "print(\"Play:\", prediction[0])\n",
        "\n",
        "print(\"Accuracy:\", model.score(X, y))\n",
        "\n",
        "# Display Decision Tree\n",
        "tree.plot_tree(model, filled=True, feature_names=list(X.columns), class_names=model.classes_)\n",
        "plt.show()"
      ]
    }
